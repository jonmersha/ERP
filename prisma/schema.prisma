generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  bannerUrl String?
  createdAt DateTime @default(now())
  ownerId   String
}

model UserProfile {
  uid       String   @id
  email     String   @unique
  name      String
  roles     String[]
  unitId    String?
  companyId String
}

model Factory {
  id        String   @id @default(uuid())
  name      String
  location  String
  companyId String
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String
  factoryId String?
  companyId String
}

model SalesOutlet {
  id        String   @id @default(uuid())
  name      String
  location  String
  companyId String
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String
  email     String?
  companyId String
}

model RawMaterial {
  id        String   @id @default(uuid())
  name      String
  unit      String
  companyId String
}

model Category {
  id        String   @id @default(uuid())
  name      String
  description String?
  companyId String
}

model Product {
  id        String   @id @default(uuid())
  name      String
  category  String
  packageSize String
  unit      String
  price     Float
  companyId String
}

model InventoryItem {
  id        String   @id @default(uuid())
  unitId    String
  itemId    String
  itemType  String
  quantity  Int
  batchNumber String?
  expiryDate  DateTime?
  companyId String
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  supplierId  String
  supplierName String
  factoryId   String
  warehouseId String
  status      String
  items       Json
  totalAmount Float
  createdBy   String
  createdAt   DateTime @default(now())
  companyId   String
}

model SalesOrder {
  id          String   @id @default(uuid())
  customerId  String?
  outletId    String
  outletName  String
  status      String
  items       Json
  totalAmount Float
  createdBy   String
  createdAt   DateTime @default(now())
  companyId   String
}

model ProductionPlan {
  id            String   @id @default(uuid())
  factoryId     String
  productId     String
  year          Int
  totalQuantity Int
  quarterlyPlans Json
  status        String
  companyId     String
}

model ProductionRun {
  id               String   @id @default(uuid())
  factoryId        String
  productId        String
  recipeId         String?
  quantity         Int
  quantityProduced Int
  status           String
  startDate        DateTime
  updatedAt        DateTime?
  companyId        String
}

model ProcurementPlan {
  id             String   @id @default(uuid())
  warehouseId    String
  materialId     String
  year           Int
  totalQuantity  Int
  quarterlyPlans Json
  status         String
  companyId      String
}

model SalesPlan {
  id             String   @id @default(uuid())
  factoryId      String
  productId      String
  year           Int
  totalQuantity  Int
  quarterlyPlans Json
  status         String
  companyId      String
}

model Recipe {
  id              String   @id @default(uuid())
  productId       String
  name            String
  bom             Json
  processingSteps Json
  yieldPercentage Float
  companyId       String
}

model Equipment {
  id                  String   @id @default(uuid())
  name                String
  type                String
  lastMaintenanceDate DateTime
  nextMaintenanceDate DateTime
  status              String
  companyId           String
}

model MaintenanceLog {
  id           String   @id @default(uuid())
  equipmentId  String
  date         DateTime
  description  String
  technician   String
  cost         Float
  companyId    String
}

model Shipment {
  id             String   @id @default(uuid())
  orderId        String
  status         String
  deliveryDate   DateTime
  temperatureLog Json
  companyId      String
}

model GRN {
  id              String   @id @default(uuid())
  purchaseOrderId String
  warehouseId     String
  receivedBy      String
  receivedAt      DateTime
  items           Json
  notes           String?
  companyId       String
}

model DeliveryNote {
  id            String   @id @default(uuid())
  salesOrderId  String
  warehouseId   String
  shippedBy     String
  shippedAt     DateTime
  items         Json
  notes         String?
  companyId     String
}

model Employee {
  id         String   @id @default(uuid())
  name       String
  email      String
  department String
  role       String
  salary     Float
  factoryId  String?
  hireDate   DateTime
  companyId  String
}

model Invoice {
  id        String   @id @default(uuid())
  orderId   String
  orderType String
  amount    Float
  dueDate   DateTime
  status    String
  companyId String
  createdAt DateTime @default(now())
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  amount        Float
  paymentDate   DateTime
  paymentMethod String
  companyId     String
}

model FinancialPlan {
  id            String   @id @default(uuid())
  year          Int
  quarter       String
  targetRevenue Float
  targetExpense Float
  companyId     String
}
